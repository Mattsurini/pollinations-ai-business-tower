# Optional. Create a publishable App Key at https://enter.pollinations.ai/keys?tab=app
# and add your deployed URL (no query/fragment) as a Redirect URI.
# Leave blank to use BYOP without app attribution — the OAuth flow still works.
VITE_POLLINATIONS_APP_KEY=

# Optional overrides for the public API endpoints (useful when testing against a staging deployment).
VITE_POLLINATIONS_AUTH_URL=https://enter.pollinations.ai
VITE_POLLINATIONS_GEN_URL=https://gen.pollinations.ai
